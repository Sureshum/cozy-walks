# Cozy Walks - Variables de Entorno
# Copia este archivo a .env y completa con tus valores

# ==================== FIREBASE (Base de datos global) ====================
# Ve a https://console.firebase.google.com/
# Crea proyecto → Authentication (Email/Password) → Firestore Database
# Project Settings → General → Your apps → Web app (</>) → Config
VITE_FIREBASE_API_KEY=tu-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-project-id
VITE_FIREBASE_STORAGE_BUCKET=tu-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Opcional: Usar emuladores de Firebase en desarrollo
# VITE_USE_FIREBASE_EMULATORS=true

# ==================== GOOGLE MAPS (Legacy - ya no se usa) ====================
# La app ahora usa OpenStreetMap + OSRM (gratis, sin API key)
# VITE_GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# ==================== APP CONFIG ====================
VITE_APP_NAME=Cozy Walks
VITE_DEFAULT_CITY=Madrid
VITE_DEFAULT_LAT=40.4168
VITE_DEFAULT_LNG=-3.7038

# Feature flags
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE=true
VITE_DEBUG_MODE=false